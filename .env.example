# =====================================================================
# PRISMA — Variables de entorno
# Copia este archivo como `.env` y ajusta los valores para tu entorno.
# NUNCA commitees el archivo `.env`.
# =====================================================================

# ---------- Entorno global ----------
ENV=development                 # development | staging | production
TZ=America/Montevideo
COMPOSE_PROJECT_NAME=prisma

# ---------- PostgreSQL (BD principal) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=prisma
POSTGRES_USER=prisma
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_MAX_CONNECTIONS=100

# ---------- Redis (caché + sesiones + rate limiting) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_DB=0

# ---------- Backend Core (Spring Boot) ----------
BACKEND_CORE_PORT=8081
BACKEND_CORE_JVM_OPTS=-Xms512m -Xmx1024m
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=change_me_this_must_be_at_least_256_bits_long_for_hs256
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
ARGON2_ITERATIONS=3
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=4
# Orígenes permitidos para CORS (separados por coma) — deben coincidir con
# donde se sirve el frontend (Nginx en prod, Vite dev server en local).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://localhost,https://prisma.local
# Habilita el JwtDecoder de Keycloak en backend-core (ver SecurityConfig.MissingIssuerCondition)
# -- su valor concreto no valida nada por sí solo, es sólo el interruptor "hay Keycloak
# configurado". No confundir con KEYCLOAK_AUTH_SERVER_URL (dirección interna de Docker que usa
# backend-core para llegar a Keycloak sin pasar por nginx).
KEYCLOAK_ISSUER_URL=https://prisma.local/auth
# Keycloak corre con hostname DINÁMICO (sin KC_HOSTNAME fijo, ver el servicio `keycloak` en
# docker-compose.yml): arma cada URL que genera (login, JWKS, issuer) a partir del host Y EL
# PROTOCOLO que usó el navegador para entrar (nginx reenvía X-Forwarded-Proto con el esquema real
# de cada request -- ver infra/nginx/conf.d/prisma-locations.inc), así que el login funciona
# igual por https://prisma.local, http://prisma.local, https://localhost, http://localhost o
# cualquier otro host/esquema que nginx tenga configurado -- no hace falta editar /etc/hosts para
# poder loguearse. Acá va la lista completa de orígenes soportados, separados por coma:
# backend-core valida el claim "iss" de cada token contra esta lista (si accedés por un
# hostname/esquema que no está acá, la SPA carga pero las llamadas a la API dan 401). Agregar un
# dominio nuevo (p.ej. producción) es sumar SUS DOS variantes (http:// y https://) acá, sin tocar
# código -- ver docs/Certificados-TLS.md.
# El http://localhost:8080 (sin TLS) es imprescindible tal cual, no un ejemplo a borrar: es la URL
# que la tabla del Quickstart documenta como acceso directo al contenedor "frontend" sin pasar por
# nginx -- sin esta entrada el login funciona pero cada llamada autenticada después da 401.
KEYCLOAK_TRUSTED_ISSUERS=https://prisma.local/auth/realms/prisma,http://prisma.local/auth/realms/prisma,https://localhost/auth/realms/prisma,http://localhost/auth/realms/prisma,http://localhost:8080/auth/realms/prisma

# ---------- Backend AI (FastAPI + Ollama + RAG) ----------
BACKEND_AI_PORT=8000
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3:8b
CHROMA_PERSIST_DIR=/data/chroma
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
# Compartida entre backend-core y backend-ai (header X-Internal-Api-Key): sin ella backend-ai
# quedaría alcanzable por cualquiera que le pegue directo al puerto expuesto. Generar con, por
# ejemplo, `openssl rand -hex 32`.
AI_INTERNAL_API_KEY=change_me_shared_between_backend_core_and_backend_ai

# ---------- Frontend (Vue 3 + Vite) ----------
FRONTEND_PORT=8080
# Rutas RELATIVAS (no orígenes absolutos): tanto el nginx del propio contenedor del frontend
# (apps/frontend/nginx.conf) como el reverse-proxy principal (infra/nginx/conf.d/prisma.conf)
# exponen /api, /ai y /auth hacia backend-core/backend-ai/Keycloak respectivamente -- así el
# navegador nunca sale del origen desde el que se sirvió la SPA (sin CORS, sin mixed content).
# Ver docs/Certificados-TLS.md para el detalle de por qué esto importa para HTTPS en tránsito.
VITE_API_BASE_URL=/api
VITE_AI_API_BASE_URL=/ai/api/v1
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=prisma
VITE_KEYCLOAK_CLIENT_ID=prisma-frontend
# LogRocket (monitoreo de frontend: session replay, errores JS, performance real de usuario).
# Es un SaaS de terceros, no autohosteado -- hace falta una cuenta propia en logrocket.com para
# conseguir este App ID (formato "org/proyecto"). Vacío = LogRocket queda apagado (no se manda
# nada), ver src/plugins/logrocket.ts.
VITE_LOGROCKET_APP_ID=

# ---------- Keycloak (SSO / IAM) ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_in_production
KEYCLOAK_PORT=8180
# Secret del client "prisma-backend" (Service Accounts habilitado, roles manage-users/view-users
# de realm-management) -- debe coincidir EXACTO con el que tenga ese client en Keycloak. El valor
# de acá abajo es el mismo que trae hardcodeado infra/keycloak/realm-prisma.json (Keycloak no
# soporta variables de entorno dentro de su JSON de import), así que sirve tal cual para
# desarrollo local -- si no coinciden, cualquier usuario nuevo creado desde Configuración →
# Usuarios queda sin cuenta en Keycloak y nunca puede loguearse (la app lo crea igual en Postgres,
# pero la llamada a la Admin API de Keycloak falla).
# Para rotarlo en cualquier ambiente que no sea tu máquina local: generá un valor nuevo (p.ej. con
# `openssl rand -base64 32`), ponelo acá, Y ADEMÁS actualizá el secret del client "prisma-backend"
# en Keycloak (Admin Console → Clients → prisma-backend → Credentials → Regenerate, pegando este
# mismo valor) o en tu copia de realm-prisma.json antes del primer `--import-realm`.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION

# ---------- MinIO (almacenamiento de evidencias) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_BUCKET_EVIDENCES=prisma-evidences
MINIO_BUCKET_REPORTS=prisma-reports
MINIO_PORT_API=9001
MINIO_PORT_CONSOLE=9002

# ---------- SonarQube ----------
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change_me_in_production
SONAR_PORT=9003
SONAR_TOKEN=

# ---------- Grafana ----------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_in_production
GRAFANA_PORT=3000

# ---------- Elasticsearch / Kibana (perfil "elastic") ----------
# Logs centralizados para búsqueda/investigación (seguridad, BD, apps) -- ver
# docs/CI-CD-Infra.md. No reemplaza a Loki/Grafana de arriba, corre aparte.
# Password del superusuario "elastic" -- con este entrás a la UI de Kibana; Filebeat también lo
# usa para escribir. NO se lo des a Kibana como credencial de conexión (ver KIBANA_SYSTEM_PASSWORD
# abajo): la versión 8.x rechaza arrancar si se le configura el superusuario.
ELASTIC_PASSWORD=change_me_in_production
# Password que el job kibana-init le setea al usuario de servicio reservado "kibana_system" --
# es con el que Kibana se conecta a Elasticsearch puertas adentro. Elegilo vos (no lo genera
# Elasticsearch), no hace falta usarlo para nada manualmente.
KIBANA_SYSTEM_PASSWORD=change_me_in_production
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
# 1g alcanza para un nodo único de dev/local -- subir si Elasticsearch se queda sin memoria
# (JVM heap fijo, no crece solo) con muchos contenedores logueando en simultáneo.
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ---------- pgAdmin ----------
# OJO: el pgadmin4 de la imagen valida el dominio del email con `email-validator`, que rechaza
# TLDs reservados por RFC 2606 (.local, .test, .example, .invalid) aunque CHECK_EMAIL_DELIVERABILITY
# esté en False (eso sólo desactiva el chequeo de MX, no el de dominios reservados) -- pgAdmin no
# arranca con admin@prisma.local. Usar un dominio "real" (no hace falta que resuelva).
PGADMIN_DEFAULT_EMAIL=admin@prisma.uy
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---------- Portainer ----------
PORTAINER_PORT=9000
PORTAINER_ADMIN_PASSWORD=change_me_at_first_login

# ---------- Watchtower ----------
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true
WATCHTOWER_NOTIFICATIONS=email
WATCHTOWER_NOTIFICATION_EMAIL_FROM=watchtower@prisma.local
WATCHTOWER_NOTIFICATION_EMAIL_TO=devops@prisma.local

# ---------- Nginx / TLS ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---------- Registro de contenedores (GHCR) ----------
GHCR_REGISTRY=ghcr.io
GHCR_ORG=your-github-org
GHCR_USER=your-github-user
GHCR_TOKEN=your_personal_access_token
