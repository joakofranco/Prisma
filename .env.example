# =====================================================================
# PRISMA — Variables de entorno
# Copia este archivo como `.env` y ajusta los valores para tu entorno.
# NUNCA commitees el archivo `.env`.
#
# Contraseñas: en todos los ambientes que no son producción (local, dev, staging) el valor
# inicial de cada contraseña es Admin1234! (Admin1234!!! donde el servicio exige 12 caracteres,
# como Portainer). En producción no se usan esos valores: se generan
# al azar al desplegar con `make prod-up` (o `make prod-secrets`), que las escribe en el `.env`
# del servidor y las muestra una sola vez en la salida. Ver docs/operacion/Ambientes-Despliegue.md.
# =====================================================================

# ---------- Entorno global ----------
# Lo informan /api/version (backend-core) y /health (backend-ai) y el frontend muestra un cartel
# «Entorno de desarrollo / pruebas» cuando no es production. Cada servidor define el suyo;
# docker-compose.prod.yml fuerza production.
ENV=development                 # development | staging | production
# Opcionales: commit y fecha de construcción que se ven en el detalle de la versión (el CI los pasa
# al construir las imágenes). Para ver algo en una construcción local:
#   GIT_SHA=$(git rev-parse --short HEAD) BUILD_TIME=$(date -u +%FT%TZ) docker compose build
TZ=America/Montevideo
COMPOSE_PROJECT_NAME=prisma

# ---------- PostgreSQL (BD principal) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=prisma
POSTGRES_USER=prisma
POSTGRES_PASSWORD=Admin1234!
POSTGRES_MAX_CONNECTIONS=100

# ---------- Redis (caché + sesiones + rate limiting) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Admin1234!
REDIS_DB=0

# ---------- Backend Core (Spring Boot) ----------
BACKEND_CORE_PORT=8081
BACKEND_CORE_JVM_OPTS="-Xms512m -Xmx1024m"
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=change_me_this_must_be_at_least_256_bits_long_for_hs256
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
ARGON2_ITERATIONS=3
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=4
# Orígenes permitidos para CORS (separados por coma) — deben coincidir con
# donde se sirve el frontend (Nginx en prod, Vite dev server en local).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://localhost,https://prisma.local
# Habilita el JwtDecoder de Keycloak en backend-core (ver SecurityConfig.MissingIssuerCondition)
# -- su valor concreto no valida nada por sí solo, es sólo el interruptor "hay Keycloak
# configurado". No confundir con KEYCLOAK_AUTH_SERVER_URL (dirección interna de Docker que usa
# backend-core para llegar a Keycloak sin pasar por nginx).
KEYCLOAK_ISSUER_URL=https://prisma.local/auth
# Keycloak corre con hostname DINÁMICO (sin KC_HOSTNAME fijo, ver el servicio `keycloak` en
# docker-compose.yml): arma cada URL que genera (login, JWKS, issuer) a partir del host Y EL
# PROTOCOLO que usó el navegador para entrar (nginx reenvía X-Forwarded-Proto con el esquema real
# de cada request -- ver infra/nginx/conf.d/prisma-locations.inc), así que el login funciona
# igual por https://prisma.local, http://prisma.local, https://localhost, http://localhost o
# cualquier otro host/esquema que nginx tenga configurado -- no hace falta editar /etc/hosts para
# poder loguearse. Acá va la lista completa de orígenes soportados, separados por coma:
# backend-core valida el claim "iss" de cada token contra esta lista (si accedés por un
# hostname/esquema que no está acá, la SPA carga pero las llamadas a la API dan 401). Agregar un
# dominio nuevo (p.ej. producción) es sumar SUS DOS variantes (http:// y https://) acá, sin tocar
# código -- ver docs/operacion/Certificados-TLS.md.
# El http://localhost:8080 (sin TLS) es imprescindible tal cual, no un ejemplo a borrar: es la URL
# que la tabla del Quickstart documenta como acceso directo al contenedor "frontend" sin pasar por
# nginx -- sin esta entrada el login funciona pero cada llamada autenticada después da 401.
KEYCLOAK_TRUSTED_ISSUERS=https://prisma.local/auth/realms/prisma,http://prisma.local/auth/realms/prisma,https://localhost/auth/realms/prisma,http://localhost/auth/realms/prisma,http://localhost:8080/auth/realms/prisma

# URL PÚBLICA de la aplicación (esquema + host, sin barra final), PRI-379. La usan las invitaciones
# por correo (RF-USR-05) para dos cosas: el host del enlace que recibe el invitado y adónde vuelve
# después de crear su contraseña. Tiene que ser la dirección con la que los usuarios entran a PRISMA
# (p. ej. https://prisma.tudominio.com) y su host debe estar en KEYCLOAK_TRUSTED_ISSUERS. Sin
# definirla, el enlace del correo salía con el nombre interno de Docker (https://keycloak:8443).
PRISMA_APP_URL=http://localhost:8080

# ---------- Backend AI (FastAPI + Ollama + RAG) ----------
BACKEND_AI_PORT=8000
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
# Un solo LLM y un solo embedding (decisión 2026-11-22). Tamaños: ~24 GB y ~1,2 GB [POR VERIFICAR con
# /api/ps]; `make pull-llm` los baja.
OLLAMA_MODEL=nemotron-3-nano:30b
# Modelo de embedding (1024 dimensiones). Cambiarlo crea colecciones nuevas (mcu-5.0__<modelo>,
# evidence-<org>__<modelo>): el marco se indexa solo al arrancar y backend-core reindexa la
# evidencia (un trabajo EVIDENCE_INDEX por archivo) e invalida las citas ya calculadas. Las
# colecciones del modelo anterior quedan para poder volver atrás.
# OLLAMA_EMBEDDING_MODEL=bge-m3
# Servidor Ollama (servicio `ollama`): modelo cargado de forma permanente, 2 pedidos en paralelo,
# 16k de contexto por ranura (la memoria crece con CONTEXT_LENGTH x NUM_PARALLEL), LLM + embedding
# cargados a la vez. Opcionales: estos son los valores por defecto.
# OLLAMA_KEEP_ALIVE=-1
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_CONTEXT_LENGTH=16384
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_MAX_QUEUE=64
# Opciones que backend-ai envía a Ollama en cada pedido. AI_NUM_CTX y AI_KEEP_ALIVE tienen que
# valer lo mismo que OLLAMA_CONTEXT_LENGTH y OLLAMA_KEEP_ALIVE (si no, Ollama recarga el modelo).
# AI_NUM_PREDICT es provisional: definirlo con las guías reales. AI_TEMPERATURE=0.1 y
# AI_NUM_THREAD=12 son con lo que se midió el banco (AI_SEED sin definir); vaciarlos = no se
# envían (rige el valor del modelo: 0,8 de temperatura). AI_THINK queda en false: con nemotron
# la guía pasa de 39 a 91 s y la cita en QA de 100 % a 62 %; solo se aplica si el modelo declara
# la capability "thinking". AI_PROMPT_MAX_TOKENS sin definir = AI_NUM_CTX -
# AI_NUM_PREDICT - 256; un prompt que no entra se rechaza (PROMPT_TOO_LARGE) en vez de recortarse.
# AI_NUM_CTX=16384
# AI_KEEP_ALIVE=-1
# AI_NUM_PREDICT=1024
# AI_TEMPERATURE=0.1
# AI_SEED=
# AI_NUM_THREAD=12
# AI_THINK=false
# AI_WARMUP=true
# AI_WARMUP_CHECK_SECONDS=60
# AI_PROMPT_MAX_TOKENS=
# Puntaje mínimo de una cita de evidencia (relevancia); vacío = sin umbral. Los puntajes de bge-m3
# no son los de nomic-embed-text: calibrar con datos reales antes de definirlo [POR VERIFICAR].
# AI_CITATION_MIN_SCORE=
# Puntaje mínimo para sugerir un control al preclasificar evidencia global; vacío = los 3 mejores.
# AI_CLASSIFY_MIN_SCORE=
CHROMA_PERSIST_DIR=/data/chroma
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
# Compartida entre backend-core y backend-ai (header X-Internal-Api-Key): sin ella backend-ai
# quedaría alcanzable por cualquiera que le pegue directo al puerto expuesto. Generar con, por
# ejemplo, `openssl rand -hex 32`.
AI_INTERNAL_API_KEY=change_me_shared_between_backend_core_and_backend_ai
# Timeouts de backend-core hacia backend-ai (PRI-358). Opcionales: estos son los valores por defecto.
# La guía de mejora genera con el LLM y tarda cerca de un minuto con Ollama local.
# AI_CONNECT_TIMEOUT=3s
# AI_READ_TIMEOUT=60s
# AI_GUIDE_READ_TIMEOUT=300s
# Preclasificación de evidencia global (~670 controles): espera propia, aparte de AI_READ_TIMEOUT.
# AI_CLASSIFY_READ_TIMEOUT=300s
# Cola de trabajos de IA (todas opcionales; ver docs/operacion/Ambientes-Despliegue.md):
# AI_JOBS_ENABLED=true
# AI_JOBS_CONCURRENCY=2
# AI_JOBS_MAX_PENDING_PER_ORG=20
# Lote de guías: máximo de controles por lote y de trabajos de lote activos por organización.
# AI_JOBS_MAX_BATCH_SIZE=20
# AI_JOBS_MAX_PENDING_BATCH_PER_ORG=60
# Modo investigación (C8): días que se conservan las trazas de la IA; 0 (por defecto) = no se borran.
# [POR VERIFICAR] el plazo: el documento de requisitos no lo define.
# AI_TRACE_RETENTION_DAYS=0
# AI_JOBS_RESULT_TTL_DAYS=30
# AI_JOBS_MAX_ATTEMPTS=2
# AI_JOBS_RETRY_BACKOFF_SECONDS=30
# AI_JOBS_POLL_INTERVAL_MS=2000
# AI_GUIDE_FEEDBACK_DAYS=30
# AI_GUIDE_READ_TIMEOUT=120s

# ---------- Frontend (Vue 3 + Vite) ----------
FRONTEND_PORT=8080
# Rutas RELATIVAS (no orígenes absolutos): tanto el nginx del propio contenedor del frontend
# (apps/frontend/nginx.conf) como el reverse-proxy principal (infra/nginx/conf.d/prisma.conf)
# exponen /api, /ai y /auth hacia backend-core/backend-ai/Keycloak respectivamente -- así el
# navegador nunca sale del origen desde el que se sirvió la SPA (sin CORS, sin mixed content).
# Ver docs/operacion/Certificados-TLS.md para el detalle de por qué esto importa para HTTPS en tránsito.
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=prisma
VITE_KEYCLOAK_CLIENT_ID=prisma-frontend
# LogRocket (monitoreo de frontend: session replay, errores JS, performance real de usuario).
# Es un SaaS de terceros, no autohosteado -- hace falta una cuenta propia en logrocket.com para
# conseguir este App ID (formato "org/proyecto"). Vacío = LogRocket queda apagado (no se manda
# nada), ver src/plugins/logrocket.ts.
VITE_LOGROCKET_APP_ID=

# ---------- Keycloak (SSO / IAM) ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Admin1234!
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=Admin1234!
KEYCLOAK_PORT=8180
# Secret del client "prisma-backend" (Service Accounts habilitado, roles manage-users/view-users
# de realm-management) -- debe coincidir EXACTO con el que tenga ese client en Keycloak. El valor
# de acá abajo es el mismo que trae hardcodeado infra/keycloak/realm-prisma.json (Keycloak no
# soporta variables de entorno dentro de su JSON de import), así que sirve tal cual para
# desarrollo local -- si no coinciden, cualquier usuario nuevo creado desde Configuración →
# Usuarios queda sin cuenta en Keycloak y nunca puede loguearse (la app lo crea igual en Postgres,
# pero la llamada a la Admin API de Keycloak falla).
# Para rotarlo en cualquier ambiente que no sea tu máquina local: generá un valor nuevo (p.ej. con
# `openssl rand -base64 32`), ponelo acá, Y ADEMÁS actualizá el secret del client "prisma-backend"
# en Keycloak (Admin Console → Clients → prisma-backend → Credentials → Regenerate, pegando este
# mismo valor) o en tu copia de realm-prisma.json antes del primer `--import-realm`.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION

# ---------- RustFS (almacenamiento S3-compatible de evidencias) ----------
# No usar "rustfsadmin" (valor por defecto público de RustFS) fuera de tu máquina local.
RUSTFS_ACCESS_KEY=prisma-admin
RUSTFS_SECRET_KEY=Admin1234!
S3_BUCKET_EVIDENCES=prisma-evidences
S3_PORT_API=9001
S3_PORT_CONSOLE=9002

# Extensiones de evidencia que acepta el backend (RF-EVI-02), separadas por coma y sin punto.
# Soportadas: pdf, zip, docx, txt, md, markdown, png, jpg, jpeg. Una extensión fuera de esa lista
# hace fallar el arranque de backend-core. No se admite SVG. La pantalla lee la lista vigente
# desde GET /api/evidence/allowed-formats.
EVIDENCE_ALLOWED_EXTENSIONS=pdf,zip,docx,txt,md,markdown,png,jpg,jpeg
# Tamaño máximo por evidencia (RF-EVI-04), con unidad: 100MB, 5MB, 512KB. Los Nginx
# (infra/nginx/nginx.conf y apps/frontend/nginx.conf) dejan pasar hasta 105m: si se sube este valor
# por encima de 105MB, subir también ese límite.
EVIDENCE_MAX_SIZE=100MB

# ---------- SonarQube ----------
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=Admin1234!
SONAR_PORT=9003
SONAR_TOKEN=

# ---------- Grafana ----------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Admin1234!
GRAFANA_PORT=3000

# ---------- Elasticsearch / Kibana (perfil "elastic") ----------
# Logs centralizados para búsqueda/investigación (seguridad, BD, apps) -- ver
# docs/operacion/CI-CD-Infra.md. No reemplaza a Loki/Grafana de arriba, corre aparte.
# Password del superusuario "elastic" -- con este entrás a la UI de Kibana; Filebeat también lo
# usa para escribir. NO se lo des a Kibana como credencial de conexión (ver KIBANA_SYSTEM_PASSWORD
# abajo): la versión 8.x rechaza arrancar si se le configura el superusuario.
ELASTIC_PASSWORD=Admin1234!
# Password que el job kibana-init le setea al usuario de servicio reservado "kibana_system" --
# es con el que Kibana se conecta a Elasticsearch puertas adentro. Elegilo vos (no lo genera
# Elasticsearch), no hace falta usarlo para nada manualmente.
KIBANA_SYSTEM_PASSWORD=Admin1234!
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
# 1g alcanza para un nodo único de dev/local -- subir si Elasticsearch se queda sin memoria
# (JVM heap fijo, no crece solo) con muchos contenedores logueando en simultáneo.
ELASTICSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# ---------- Alertas por correo (Alertmanager) ----------
# Las alertas de caída, saturación, DoS y fuerza bruta se envían por correo desde Alertmanager.
# Por defecto salen a Mailpit (buzón de pruebas del stack, UI en http://localhost:8025): no hace
# falta configurar nada para verlas en desarrollo. En producción, la cuenta SMTP PROPIA del
# sistema (nunca el buzón de una persona) y el correo del administrador que las recibe.
# Valores iniciales de las alertas. Una vez que el administrador guarda la configuración en la
# plataforma (Configuración → Alertas del sistema), esa configuración manda y estas variables se ignoran.
ALERT_EMAIL_TO=admin@prisma.uy
ALERT_SMTP_FROM=alertas@prisma.uy
ALERT_SMTP_SMARTHOST=mailpit:1025
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=false
# MAILPIT_UI_PORT=8025
# ALERTMANAGER_PORT=9093

# ---------- Correo del sistema (SMTP de Keycloak) ----------
# Cuenta PROPIA del sistema (ej. no-reply@dominio), nunca el buzón de una persona. La aplica al realm
# scripts/keycloak/apply-auth-policy.sh; desde ahí Keycloak envía invitaciones y recuperaciones de
# contraseña. Sin SMTP_HOST el script no toca el SMTP del realm. En desarrollo: un buzón de pruebas.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_NAME=PRISMA
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---------- pgAdmin ----------
# OJO: el pgadmin4 de la imagen valida el dominio del email con `email-validator`, que rechaza
# TLDs reservados por RFC 2606 (.local, .test, .example, .invalid) aunque CHECK_EMAIL_DELIVERABILITY
# esté en False (eso sólo desactiva el chequeo de MX, no el de dominios reservados) -- pgAdmin no
# arranca con admin@prisma.local. Usar un dominio "real" (no hace falta que resuelva).
PGADMIN_DEFAULT_EMAIL=admin@prisma.uy
PGADMIN_DEFAULT_PASSWORD=Admin1234!
PGADMIN_PORT=5050

# ---------- Portainer ----------
PORTAINER_PORT=9000
# Portainer exige al menos 12 caracteres: su contraseña inicial es Admin1234!!!. No se lee de
# esta variable sino del archivo .secrets/portainer_admin_password, que `make up` crea con ese
# valor si no existe.
PORTAINER_ADMIN_PASSWORD=Admin1234!!!

# ---------- Watchtower ----------
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true
WATCHTOWER_NOTIFICATIONS=email
WATCHTOWER_NOTIFICATION_EMAIL_FROM=watchtower@prisma.local
WATCHTOWER_NOTIFICATION_EMAIL_TO=devops@prisma.local

# ---------- Backup y restauración (RNF-13) ----------
# Días de retención de los dumps en ./backups antes de que backup.sh los borre.
BACKUP_RETENTION_DAYS=30
# Opcional: URL de webhook (Slack/Discord/Teams-compatible) para avisar si el respaldo diario
# falla (dump corrupto/vacío, o no se pudo espejar el bucket de evidencias). Vacío = sin alertas.
BACKUP_ALERT_WEBHOOK_URL=

# ---------- URL pública ----------
# URL base pública del sistema (sin barra final). La usan los correos de Keycloak para armar la
# URL absoluta del logo (${PUBLIC_BASE_URL}/auth/resources/...): los clientes de correo no pueden
# resolver rutas relativas. Debe ser alcanzable desde Internet/la red de quien lee el correo.
PUBLIC_BASE_URL=https://prisma.local

# ---------- Nginx / TLS ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---------- Registro de contenedores (GHCR) ----------
GHCR_REGISTRY=ghcr.io
GHCR_ORG=your-github-org
GHCR_USER=your-github-user
GHCR_TOKEN=your_personal_access_token

# ---------- fail2ban ----------
# IPs que fail2ban nunca bloquea (separadas por espacio). 172.28.0.1 es la puerta de enlace de
# prisma-net: en desarrollo local con Docker Desktop, todo el tráfico del host hacia un puerto
# publicado llega así, y sin ignorarla una ráfaga de pruebas desde el propio equipo termina
# autobloqueando al desarrollador. En producción (sin Docker Desktop de por medio) quitarla y
# agregar en su lugar la IP de la VPN y la de administración; detrás de un proxy o balanceador,
# agregar también su IP.
F2B_IGNORE_IPS=127.0.0.1/8 ::1 172.28.0.1

# ---------- Publicación con Cloudflare Tunnel (docker-compose.cloudflare.yml) ----------
# Ver docs/operacion/PUBLICACION-CLOUDFLARE.md.
# IP de la VPN en el VPS: en ella se publican NGINX (administración) y las herramientas internas.
INTERNAL_BIND_IP=127.0.0.1
# Puerto local por el que cloudflared (instalado en el VPS) entra a NGINX.
TUNNEL_ORIGIN_PORT=8443
# En producción agregar el dominio público a las variables de arriba, por ejemplo:
#   CORS_ALLOWED_ORIGINS=...,https://prisma.tudominio.com
#   KEYCLOAK_TRUSTED_ISSUERS=...,https://prisma.tudominio.com/auth/realms/prisma
#   KEYCLOAK_ISSUER_URL=https://prisma.tudominio.com/auth
# Control de VPN del lanzador de Servicios (edición de las URL): solo la red de la VPN.
#   SERVICES_ALLOWED_CIDRS=10.8.0.0/24,127.0.0.0/8

# ---------- Pruebas de performance (JMeter), ver docs/desarrollo/PERFORMANCE.md ----------
# Se leen del entorno al correr `make perf*`; ninguna es obligatoria en local.
# PERF_NETWORK=prisma-net                # red Docker del stack (se detecta prisma-swarm-net o prisma-net)
# PERF_CLIENT_SECRET=                    # secreto de prisma-backend (por defecto KEYCLOAK_ADMIN_CLIENT_SECRET)
# PERF_PERMITIR_REMOTO=1                 # necesario si BASE_URL apunta a un entorno remoto
# PERF_PERMITIR_DISRUPTIVO=1             # necesario para CP-RND-06 (estrés) y CP-OBS-08 (inundación)
# PERF_USUARIOS=20                       # cantidad de usuarios PERF- que crea make perf-setup

# ---------- Escaneo de vulnerabilidades (servicio vuln-scanner, perfil observability) ----------
# Escaneo diario con Trivy; los resultados se ven en el tablero «PRISMA · Vulnerabilidades» de Grafana.
# Ver docs/operacion/Vulnerabilidades.md.
# VULN_HORA=03:00                        # hora del escaneo diario (zona horaria TZ)
# VULN_ESCANEAR_AL_INICIAR=true          # escanear también al levantar el servicio
