<?xml version="1.0" encoding="UTF-8"?>
<!--
  RNF-10: todas las líneas de log de consola pasan por MaskingPatternLayout (ver
  uy.edu.prisma.config.MaskingPatternLayout), que enmascara contraseñas, tokens y encabezados
  Authorization/Bearer antes de escribirlas. Los niveles (root, uy.edu.prisma, etc.) siguen
  pisados en runtime por "logging.level.*" de application.yml, igual que con el logback.xml por
  defecto de Spring Boot: los valores de abajo son sólo el default si esa propiedad no está.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <layout class="uy.edu.prisma.config.MaskingPatternLayout">
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <logger name="uy.edu.prisma" level="INFO" />
    <logger name="org.hibernate.SQL" level="WARN" />
</configuration>
