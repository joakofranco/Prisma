{{/* Traduce la severidad de la alerta (critical/warning, en inglés por convención de Prometheus/
     Grafana) al español, sólo para mostrarla en el correo -- las etiquetas quedan como están. */}}
{{ define "prisma.sev" }}{{ if eq . "critical" }}crítica{{ else if eq . "warning" }}advertencia{{ else }}{{ . }}{{ end }}{{ end }}

{{ define "prisma.email.html" }}
<div style="font-family:'Segoe UI',Arial,sans-serif;max-width:640px;margin:0 auto;color:#0f172a">
  <div style="background:#0f172a;padding:18px 20px;border-radius:12px 12px 0 0">
    <span style="color:#3b82f6;font-size:20px;font-weight:bold;letter-spacing:0.08em;">&#9632;</span>
    <span style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:0.08em;vertical-align:middle;">PRISMA</span>
    <div style="color:#94a3b8;font-size:13px;margin-top:6px">Alertas de la plataforma</div>
  </div>
  <div style="border:1px solid #e2e8f0;border-top:none;border-radius:0 0 12px 12px;padding:18px 20px">
    <p style="margin:0 0 14px">
      {{ if eq .Status "firing" }}
      <span style="display:inline-block;background:#fef2f2;color:#b91c1c;font-weight:700;font-size:13px;padding:4px 12px;border-radius:999px">{{ .Alerts.Firing | len }} alerta(s) activa(s)</span>
      {{ else }}
      <span style="display:inline-block;background:#f0fdf4;color:#15803d;font-weight:700;font-size:13px;padding:4px 12px;border-radius:999px">Resuelta</span>
      {{ end }}
    </p>
    {{ range .Alerts }}
    <div style="border-left:4px solid {{ if eq .Status "resolved" }}#16a34a{{ else if eq .Labels.severity "critical" }}#dc2626{{ else }}#f59e0b{{ end }};background:#f8fafc;padding:10px 14px;margin:0 0 10px;border-radius:6px">
      <div style="font-weight:600">{{ .Annotations.summary }}</div>
      <div style="font-size:14px;margin-top:4px;color:#334155">{{ .Annotations.description }}</div>
      <div style="font-size:12px;color:#64748b;margin-top:6px">
        Severidad: {{ template "prisma.sev" .Labels.severity }} · Categoría: {{ .Labels.category }} ·
        {{ if eq .Status "resolved" }}Resuelta{{ else }}Desde{{ end }}:
        {{ (.StartsAt | tz "America/Montevideo").Format "02/01/2006 15:04:05" }} (hora de Montevideo)
      </div>
    </div>
    {{ end }}
    <p style="font-size:12px;color:#64748b;margin:14px 0 0">
      Estas alertas también se ven en el tablero «PRISMA · Estado general y alertas» de Grafana.
    </p>
  </div>
</div>
{{ end }}
