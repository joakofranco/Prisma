    {
      "id": 13,
      "type": "timeseries",
      "title": "Vulnerabilidades por severidad a lo largo del tiempo",
      "datasource": "Prometheus",
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum by (severidad) (prisma_vuln_total)",
          "legendFormat": "{{severidad}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MEDIUM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Vulnerabilidades críticas y altas (primeras 400)",
      "datasource": "Prometheus",
      "description": "Cada fila es una vulnerabilidad. «sin parche» indica que todavía no hay versión corregida.",
      "gridPos": {
        "w": 24,
        "h": 14,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "format": "table",
          "instant": true,
          "expr": "prisma_vuln_detalle"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "cluster": true,
              "environment": true,
              "exported_job": true
            },
            "indexByName": {
              "severidad": 0,
              "cve": 1,
              "tipo": 2,
              "objetivo": 3,
              "paquete": 4,
              "instalada": 5,
              "corregida": 6
            },
            "renameByName": {
              "severidad": "Severidad",
              "cve": "CVE",
              "tipo": "Tipo",
              "objetivo": "Objetivo",
              "paquete": "Paquete",
              "instalada": "Versión instalada",
              "corregida": "Versión corregida"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Ver en NVD",
                    "url": "https://nvd.nist.gov/vuln/detail/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severidad"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "text": "CRITICAL"
                      },
                      "HIGH": {
                        "color": "orange",
                        "text": "HIGH"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Severidad",
            "desc": false
          }
        ]
      }
    }
