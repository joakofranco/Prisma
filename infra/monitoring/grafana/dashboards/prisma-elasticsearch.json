    {
      "id": 2,
      "type": "stat",
      "title": "Estado del clúster",
      "datasource": "Prometheus",
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(elasticsearch_cluster_health_status{color=\"green\"}) * 0 + (max(elasticsearch_cluster_health_status{color=\"yellow\"}) * 1) + (max(elasticsearch_cluster_health_status{color=\"red\"}) * 2)",
          "legendFormat": "",
          "refId": "A",
          "datasource": "Prometheus",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "VERDE",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "AMARILLO",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "ROJO",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      }
    },
