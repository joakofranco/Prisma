      "id": 15,
      "type": "timeseries",
      "title": "Comandos por segundo / hit ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[5m])",
          "legendFormat": "comandos/s",
          "refId": "A",
          "datasource": "Prometheus"
