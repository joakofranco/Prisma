    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Red por contenedor (recibida / enviada)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"prisma-.+\"}[5m]))",
          "legendFormat": "{{name}} ↓",
          "refId": "A",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"prisma-.+\"}[5m]))",
          "legendFormat": "{{name}} ↑",
          "refId": "B",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
