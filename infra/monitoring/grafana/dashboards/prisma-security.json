    {
      "id": 8,
      "type": "table",
      "title": "Alertas de seguridad en curso",
      "datasource": "Prometheus",
      "gridPos": {
        "w": 24,
        "h": 6,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=~\"firing|pending\",category=\"security\"}",
          "legendFormat": "",
          "refId": "A",
          "datasource": "Prometheus",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "alertname",
                "severity",
                "category",
                "alertstate",
                "name",
                "service",
                "device"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "alertstate": 2,
              "category": 3,
              "service": 4,
              "name": 5,
              "device": 6
            },
            "renameByName": {
              "alertname": "Alerta",
              "severity": "Severidad",
              "category": "Categoría",
              "alertstate": "Estado",
              "name": "Contenedor",
              "service": "Servicio",
              "device": "Disco"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severidad"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "CRÍTICA",
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "text": "ADVERTENCIA",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "ACTIVA",
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "text": "PENDIENTE",
                        "color": "yellow",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
